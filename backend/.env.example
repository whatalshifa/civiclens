# Copy to .env for local development. Every setting is read in app/config.py (prefix CL_).

# Postgres 16+ (full-text search is a Postgres feature). `docker compose up db` gives you this one.
CL_DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens

# "production" hides the interactive API docs (/docs).
CL_ENV=development

# A shared secret the website sends with every request. When set, the API refuses requests
# without it. Must match API_PROXY_SECRET on the website. Leave empty locally.
CL_PROXY_SECRET=

# Turns on live answers from the rights assistant (no CL_ prefix). Without it, the assistant runs
# in demo mode and replays its prepared sample answers.
# ANTHROPIC_API_KEY=
# CL_CLAUDE_MODEL=claude-opus-5-5
# CL_ASSISTANT_EFFORT=medium
# CL_ASSISTANT_MAX_ROUNDS=8

# Spending guards for live answers: per visitor's network per hour, and for the whole site per day.
# CL_ASSISTANT_PER_IP_PER_HOUR=10
# CL_ASSISTANT_RUNS_PER_DAY=200

# Seconds between replayed steps in demo mode.
# CL_DEMO_STEP_DELAY=0.5

# Origins allowed to call the API from a browser (local tools only; the website calls it server-side).
# CL_CORS_ORIGINS=["http://localhost:3000"]

# Load app/data into the database on start when the files changed.
# CL_LOAD_DATA_ON_START=true
