# Copy to .env.local for local development.

# Where the website fetches its data from (the FastAPI backend).
API_URL=http://localhost:8000

# Must match CL_PROXY_SECRET on the API when that is set.
# API_PROXY_SECRET=

# The site's public address, for canonical links, the sitemap and link previews. On Vercel the
# production domain is used when this isn't set; locally it defaults to http://localhost:3000.
# SITE_URL=https://civiclens-ruby.vercel.app
